<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lake.booking.module.boat_time_config.mapper.BoatTimeConfigMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND boatTimeConfig.id = #{entity.id}
            </if>
            <if test="entity.boatId != null">
                AND boatTimeConfig.boat_id = #{entity.boatId}
            </if>
            <if test="entity.appointDateStart != null and entity.appointDateEnd != null">
                AND boatTimeConfig.appoint_date BETWEEN #{entity.appointDateStart} AND #{entity.appointDateEnd}
            </if>
            <if test="entity.boatName != null and entity.boatName != ''">
                AND boat.boat_name LIKE CONCAT('%', #{entity.boatName}, '%')
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.lake.booking.module.boat_time_config.entity.BoatTimeConfig">
        SELECT boatTimeConfig.*
        , boat.boat_name AS boatName
        FROM boat_time_config boatTimeConfig
        LEFT JOIN boat boat ON boatTimeConfig.boat_id = boat.id
        <include refid="whereCondition"/>
        ORDER BY boatTimeConfig.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM boat_time_config boatTimeConfig
        LEFT JOIN boat boat ON boatTimeConfig.boat_id = boat.id
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.lake.booking.module.boat_time_config.entity.BoatTimeConfig">
        SELECT boatTimeConfig.*
        , boat.boat_name AS boatName
        FROM boat_time_config boatTimeConfig
        LEFT JOIN boat boat ON boatTimeConfig.boat_id = boat.id
        <include refid="whereCondition"/>
        ORDER BY boatTimeConfig.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.lake.booking.module.boat_time_config.entity.BoatTimeConfig">
        SELECT boatTimeConfig.*
        , boat.boat_name AS boatName
        FROM boat_time_config boatTimeConfig
        LEFT JOIN boat boat ON boatTimeConfig.boat_id = boat.id
        WHERE boatTimeConfig.id = #{id}
    </select>

</mapper>
