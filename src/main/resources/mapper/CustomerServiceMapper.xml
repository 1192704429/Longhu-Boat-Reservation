<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lake.booking.module.customer_service.mapper.CustomerServiceMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND customerService.id = #{entity.id}
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.lake.booking.module.customer_service.entity.CustomerService">
        SELECT customerService.*
        FROM customer_service customerService
        <include refid="whereCondition"/>
        ORDER BY customerService.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM customer_service customerService
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.lake.booking.module.customer_service.entity.CustomerService">
        SELECT customerService.*
        FROM customer_service customerService
        <include refid="whereCondition"/>
        ORDER BY customerService.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.lake.booking.module.customer_service.entity.CustomerService">
        SELECT customerService.*
        FROM customer_service customerService
        WHERE customerService.id = #{id}
    </select>

</mapper>
