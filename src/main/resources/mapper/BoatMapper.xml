<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lake.booking.module.boat.mapper.BoatMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND boat.id = #{entity.id}
            </if>
            <if test="entity.boatName != null and entity.boatName != ''">
                AND boat.boat_name LIKE CONCAT('%', #{entity.boatName}, '%')
            </if>
            <if test="entity.boatType != null">
                AND boat.boat_type = #{entity.boatType}
            </if>
            <if test="entity.status != null">
                AND boat.status = #{entity.status}
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.lake.booking.module.boat.entity.Boat">
        SELECT boat.*
        FROM boat boat
        <include refid="whereCondition"/>
        ORDER BY boat.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM boat boat
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.lake.booking.module.boat.entity.Boat">
        SELECT boat.*
        FROM boat boat
        <include refid="whereCondition"/>
        ORDER BY boat.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.lake.booking.module.boat.entity.Boat">
        SELECT boat.*
        FROM boat boat
        WHERE boat.id = #{id}
    </select>

</mapper>
