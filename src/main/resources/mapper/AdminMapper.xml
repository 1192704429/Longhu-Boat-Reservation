<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lake.booking.module.admin.mapper.AdminMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND admin.id = #{entity.id}
            </if>
            <if test="entity.username != null and entity.username != ''">
                AND admin.username LIKE CONCAT('%', #{entity.username}, '%')
            </if>
            <if test="entity.role != null and entity.role != ''">
                AND admin.role = #{entity.role}
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.lake.booking.module.admin.entity.Admin">
        SELECT admin.*
        FROM admin admin
        <include refid="whereCondition"/>
        ORDER BY admin.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM admin admin
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.lake.booking.module.admin.entity.Admin">
        SELECT admin.*
        FROM admin admin
        <include refid="whereCondition"/>
        ORDER BY admin.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.lake.booking.module.admin.entity.Admin">
        SELECT admin.*
        FROM admin admin
        WHERE admin.id = #{id}
    </select>

</mapper>
