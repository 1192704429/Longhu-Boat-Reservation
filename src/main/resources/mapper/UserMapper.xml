<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lake.booking.module.user.mapper.UserMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND user.id = #{entity.id}
            </if>
            <if test="entity.username != null and entity.username != ''">
                AND user.username LIKE CONCAT('%', #{entity.username}, '%')
            </if>
            <if test="entity.phone != null and entity.phone != ''">
                AND user.phone LIKE CONCAT('%', #{entity.phone}, '%')
            </if>
            <if test="entity.email != null and entity.email != ''">
                AND user.email LIKE CONCAT('%', #{entity.email}, '%')
            </if>
            <if test="entity.gender != null">
                AND user.gender = #{entity.gender}
            </if>
            <if test="entity.role != null and entity.role != ''">
                AND user.role = #{entity.role}
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.lake.booking.module.user.entity.User">
        SELECT user.*
        FROM user user
        <include refid="whereCondition"/>
        ORDER BY user.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM user user
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.lake.booking.module.user.entity.User">
        SELECT user.*
        FROM user user
        <include refid="whereCondition"/>
        ORDER BY user.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.lake.booking.module.user.entity.User">
        SELECT user.*
        FROM user user
        WHERE user.id = #{id}
    </select>

</mapper>
